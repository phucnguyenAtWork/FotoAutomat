<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FotoAutomat.Desktop" x:Class="FotoAutomat.Desktop.MainWindow" Title="FotoAutomat | Customer UI preview" Width="1360" Height="850" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#FAF3E9" FontFamily="Segoe UI" UseLayoutRounding="True" PreviewKeyDown="OnWindowKey">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CustomerTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <local:IndexEqualsConverter x:Key="Equal"/>
      <DataTemplate x:Key="Welcome">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text=""/>
            </StackPanel>
            <Grid>
              <Ellipse Width="570" Height="480" Opacity="0.7">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#F3D2DF"/>
                    <GradientStop Color="#00FAF3E9" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <StackPanel VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" Foreground="{StaticResource Ink}" FontSize="78" FontFamily="{StaticResource HeadingFont}">
                  <Run Text="Foto " FontStyle="Italic"/>
                  <Run Text="Hunter" FontWeight="Bold"/>
                </TextBlock>
                <Button Content="CHẠM ĐỂ BẮT ĐẦU" Click="OnNext" Style="{StaticResource Back}" BorderBrush="{StaticResource Rose}" Foreground="{StaticResource ActionRose}" FontFamily="{StaticResource HeadingFont}" FontSize="28" Margin="0,46,0,10" HorizontalAlignment="Center" Padding="52,20"/>
                <TextBlock Text="TOUCH TO START" Style="{StaticResource Body}"/>
              </StackPanel>
            </Grid>
          </Grid>
          <TextBlock Grid.Row="1" Text="FOTO HUNTER PHOTOBOOTH" VerticalAlignment="Bottom" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Filter">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Chọn bộ lọc màu ảnh"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="SELECT COLOR FILTER"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Style="{StaticResource Choice}" Width="295" Height="160" Tag="f0" GroupName="FilterIndex" Click="OnChoice" IsChecked="{Binding FilterIndex, Converter={StaticResource Equal}, ConverterParameter=0, Mode=OneWay}">
                  <StackPanel>
                    <Ellipse Width="62" Height="62" Stroke="{StaticResource Wine}" StrokeThickness="2">
                      <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#F1D4B4"/>
                          <GradientStop Color="#E6A1B7" Offset="1"/>
                        </LinearGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Bộ lọc 1" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Choice}" Width="295" Height="160" Tag="f1" GroupName="FilterIndex" Click="OnChoice" IsChecked="{Binding FilterIndex, Converter={StaticResource Equal}, ConverterParameter=1, Mode=OneWay}">
                  <StackPanel>
                    <Ellipse Width="62" Height="62" Stroke="{StaticResource Wine}" StrokeThickness="2">
                      <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#C4B797"/>
                          <GradientStop Color="#716351" Offset="1"/>
                        </LinearGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Bộ lọc 2" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Choice}" Width="295" Height="160" Tag="f2" GroupName="FilterIndex" Click="OnChoice" IsChecked="{Binding FilterIndex, Converter={StaticResource Equal}, ConverterParameter=2, Mode=OneWay}">
                  <StackPanel>
                    <Ellipse Width="62" Height="62" Stroke="{StaticResource Wine}" StrokeThickness="2">
                      <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#44372F"/>
                          <GradientStop Color="#BAAEA2" Offset="1"/>
                        </LinearGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Bộ lọc 3" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  </StackPanel>
                </RadioButton>
              </StackPanel>
              <TextBlock Text="Bộ lọc do quản trị viên cửa hàng thiết lập" Style="{StaticResource Body}" FontSize="15" Margin="0,30,0,0"/>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="TIẾP TỤC" Style="{StaticResource Action}" Click="OnNext"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Layout">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Chọn khung ảnh"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="SELECT YOUR LAYOUT"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
              <RadioButton Style="{StaticResource Choice}" Width="215" Height="225" Tag="l0" GroupName="LayoutIndex" Click="OnChoice" IsChecked="{Binding LayoutIndex, Converter={StaticResource Equal}, ConverterParameter=0, Mode=OneWay}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="32" Height="88" BorderBrush="{StaticResource Wine}" BorderThickness="2" CornerRadius="4" Margin="3">
                      <UniformGrid Rows="3">
                        <Border Background="{StaticResource Blush}" Margin="2"/>
                        <Border Background="{StaticResource Blush}" Margin="2"/>
                        <Border Background="{StaticResource Blush}" Margin="2"/>
                      </UniformGrid>
                    </Border>
                    <Border Width="32" Height="88" BorderBrush="{StaticResource Wine}" BorderThickness="2" CornerRadius="4" Margin="3">
                      <UniformGrid Rows="3">
                        <Border Background="{StaticResource Blush}" Margin="2"/>
                        <Border Background="{StaticResource Blush}" Margin="2"/>
                        <Border Background="{StaticResource Blush}" Margin="2"/>
                      </UniformGrid>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="Khổ nhỏ 1+1" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  <TextBlock Text="Small size 1+1" Style="{StaticResource Body}" FontSize="14" Margin="0,10,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource Choice}" Width="215" Height="225" Tag="l1" GroupName="LayoutIndex" Click="OnChoice" IsChecked="{Binding LayoutIndex, Converter={StaticResource Equal}, ConverterParameter=1, Mode=OneWay}">
                <StackPanel>
                  <Border Width="74" Height="88" BorderBrush="{StaticResource Wine}" BorderThickness="2" CornerRadius="4" HorizontalAlignment="Center">
                    <UniformGrid Rows="2" Columns="2">
                      <Border Background="{StaticResource Blush}" Margin="2"/>
                      <Border Background="{StaticResource Blush}" Margin="2"/>
                      <Border Background="{StaticResource Blush}" Margin="2"/>
                      <Border Background="{StaticResource Blush}" Margin="2"/>
                    </UniformGrid>
                  </Border>
                  <TextBlock Text="Khổ lớn 1+1" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  <TextBlock Text="Big size 1+1" Style="{StaticResource Body}" FontSize="14" Margin="0,10,0,0"/>
                </StackPanel>
              </RadioButton>
              <StackPanel Margin="38,0,0,0">
                <TextBlock Text="SỐ LƯỢNG ẢNH" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}"/>
                <RadioButton Style="{StaticResource Choice}" Width="122" Height="65" Tag="q0" GroupName="PackageIndex" Click="OnChoice" IsChecked="{Binding PackageIndex, Converter={StaticResource Equal}, ConverterParameter=0, Mode=OneWay}" Padding="8">
                  <StackPanel>
                    <TextBlock Text="2" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="Bold" TextAlignment="Center" Margin="0"/>
                    <TextBlock Text="80.000đ" TextAlignment="Center" FontSize="13"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Choice}" Width="122" Height="65" Tag="q1" GroupName="PackageIndex" Click="OnChoice" IsChecked="{Binding PackageIndex, Converter={StaticResource Equal}, ConverterParameter=1, Mode=OneWay}" Padding="8">
                  <StackPanel>
                    <TextBlock Text="4" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="Bold" TextAlignment="Center" Margin="0"/>
                    <TextBlock Text="140.000đ" TextAlignment="Center" FontSize="13"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Choice}" Width="122" Height="65" Tag="q2" GroupName="PackageIndex" Click="OnChoice" IsChecked="{Binding PackageIndex, Converter={StaticResource Equal}, ConverterParameter=2, Mode=OneWay}" Padding="8">
                  <StackPanel>
                    <TextBlock Text="6" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="Bold" TextAlignment="Center" Margin="0"/>
                    <TextBlock Text="210.000đ" TextAlignment="Center" FontSize="13"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Choice}" Width="122" Height="65" Tag="q3" GroupName="PackageIndex" Click="OnChoice" IsChecked="{Binding PackageIndex, Converter={StaticResource Equal}, ConverterParameter=3, Mode=OneWay}" Padding="8">
                  <StackPanel>
                    <TextBlock Text="8" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="Bold" TextAlignment="Center" Margin="0"/>
                    <TextBlock Text="280.000đ" TextAlignment="Center" FontSize="13"/>
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="THANH TOÁN" Style="{StaticResource Action}" Click="OnNext"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Payment">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Phương thức thanh toán"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="PAYMENT METHOD"/>
            </StackPanel>
            <Border Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0" Padding="20,12">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OrderSummary}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Amount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Wine}" Margin="24,0,0,0"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0">
              <Button Tag="cash" Click="OnPaymentChoice" Style="{StaticResource Back}" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" Width="275" Height="205" Margin="18">
                <StackPanel>
                  <TextBlock Text="▣" FontSize="44" Foreground="{StaticResource Wine}" TextAlignment="Center"/>
                  <TextBlock Text="Tiền mặt" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  <TextBlock Text="Cash" Style="{StaticResource Body}" FontSize="15" Margin="0,12,0,0"/>
                </StackPanel>
              </Button>
              <Button Tag="qr" Click="OnPaymentChoice" Style="{StaticResource Back}" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" Width="275" Height="205" Margin="18">
                <StackPanel>
                  <TextBlock Text="▦" FontSize="44" Foreground="{StaticResource Wine}" TextAlignment="Center"/>
                  <TextBlock Text="Chuyển khoản QR" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  <TextBlock Text="Bank / e-wallet QR" Style="{StaticResource Body}" FontSize="15" Margin="0,12,0,0"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="QrPayment">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Quét mã để thanh toán"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="SCAN WITH YOUR BANKING OR E-WALLET APP"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,60,0,0">
              <Border Width="205" Height="205" CornerRadius="16" BorderBrush="{StaticResource Rose}" BorderThickness="2" Background="{StaticResource Card}" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="[MÃ QR]" Foreground="{StaticResource ActionRose}" FontSize="20" TextAlignment="Center"/>
                  <TextBlock Text="Bản xem trước" Style="{StaticResource Body}" FontSize="14" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding Amount}" Style="{StaticResource Heading}" FontSize="27" Margin="0,18,0,0"/>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="ĐÃ THANH TOÁN · MÔ PHỎNG" Style="{StaticResource Action}" Click="OnNext"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="CashPayment">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Thanh toán tiền mặt"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="Hệ thống không trả lại tiền thừa · vui lòng cho đúng số tiền"/>
            </StackPanel>
            <UniformGrid Columns="3" VerticalAlignment="Center" Margin="100,40,100,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SỐ TIỀN ĐÃ NHẬN" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="0đ" Style="{StaticResource Heading}" Margin="0,20,0,0"/>
              </StackPanel>
              <Border Style="{StaticResource Panel}" Width="94" Height="120" BorderBrush="{StaticResource Wine}">
                <TextBlock Text="↑" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CẦN THANH TOÁN" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Amount}" Style="{StaticResource Heading}" Foreground="{StaticResource Wine}" Margin="0,20,0,0"/>
              </StackPanel>
            </UniformGrid>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="ĐÃ ĐỦ TIỀN · MÔ PHỎNG" Style="{StaticResource Action}" Click="OnNext"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Instructions">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Hướng dẫn chụp"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,40,0,0">
              <Border Width="172" Height="172" BorderBrush="{StaticResource Rose}" BorderThickness="2" CornerRadius="28" HorizontalAlignment="Center">
                <Grid>
                  <Ellipse Width="115" Height="115" Fill="{StaticResource Rose}" Stroke="{StaticResource Wine}" StrokeThickness="3"/>
                  <Ellipse Width="34" Height="34" Fill="{StaticResource Cream}" Stroke="{StaticResource Ink}" StrokeThickness="2"/>
                </Grid>
              </Border>
              <TextBlock Text="Nhìn thẳng ống kính, giữ dáng đến khi chụp xong." Style="{StaticResource Body}" Margin="0,28,0,0"/>
              <TextBlock Text="Bạn có thể chụp lại tối đa 4 lần." Style="{StaticResource Body}" Margin="0,10,0,0"/>
              <Button Content="SẴN SÀNG" Click="OnNext" Style="{StaticResource Action}" HorizontalAlignment="Center" Margin="0,30,0,0"/>
            </StackPanel>
          </Grid>
        <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack" />
</Grid>
      </DataTemplate>
      <DataTemplate x:Key="Capture">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text=""/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <Border Width="218" Height="218" CornerRadius="109" BorderBrush="{StaticResource Rose}" BorderThickness="2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CaptureDisplay}" FontFamily="{StaticResource HeadingFont}" FontSize="94" Foreground="{StaticResource Cream}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="GIỮ NGUYÊN TƯ THẾ · HOLD YOUR POSE" Style="{StaticResource Body}" Foreground="{StaticResource Cream}" Margin="0,28,0,0"/>
              <TextBlock Text="{Binding CaptureLabel}" Style="{StaticResource Body}" Foreground="{StaticResource Cream}" Margin="0,14,0,0"/>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Foreground="{StaticResource Cream}" BorderBrush="{StaticResource Cream}" Click="OnBack"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="CHỌN ẢNH VÀO KHUNG" Style="{StaticResource Action}" Click="OnNext" IsEnabled="{Binding CanSelectPhotos}"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Selection">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Chọn ảnh vào khung"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="TAP A PHOTO, THEN TAP A SLOT"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,60,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Style="{StaticResource Panel}" Padding="16" VerticalAlignment="Center">
                  <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource Slot}" Tag="{Binding Index}" Click="OnSlot" AutomationProperties.Name="{Binding Label}">
                          <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <StackPanel Margin="40,0,0,0">
                  <TextBlock Text="ẢNH ĐÃ CHỤP" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}"/>
                  <WrapPanel Width="336" Margin="0,14,0,0">
                    <RadioButton Style="{StaticResource Choice}" Width="92" Height="100" Tag="p1" GroupName="Photos" Click="OnChoice" IsChecked="{Binding SelectedPhoto, Converter={StaticResource Equal}, ConverterParameter=1, Mode=OneWay}" Padding="6">
                      <StackPanel>
                        <TextBlock Text="1" FontFamily="{StaticResource HeadingFont}" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Ảnh mẫu" FontSize="12" TextAlignment="Center"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Choice}" Width="92" Height="100" Tag="p2" GroupName="Photos" Click="OnChoice" IsChecked="{Binding SelectedPhoto, Converter={StaticResource Equal}, ConverterParameter=2, Mode=OneWay}" Padding="6">
                      <StackPanel>
                        <TextBlock Text="2" FontFamily="{StaticResource HeadingFont}" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Ảnh mẫu" FontSize="12" TextAlignment="Center"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Choice}" Width="92" Height="100" Tag="p3" GroupName="Photos" Click="OnChoice" IsChecked="{Binding SelectedPhoto, Converter={StaticResource Equal}, ConverterParameter=3, Mode=OneWay}" Padding="6">
                      <StackPanel>
                        <TextBlock Text="3" FontFamily="{StaticResource HeadingFont}" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Ảnh mẫu" FontSize="12" TextAlignment="Center"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Choice}" Width="92" Height="100" Tag="p4" GroupName="Photos" Click="OnChoice" IsChecked="{Binding SelectedPhoto, Converter={StaticResource Equal}, ConverterParameter=4, Mode=OneWay}" Padding="6">
                      <StackPanel>
                        <TextBlock Text="4" FontFamily="{StaticResource HeadingFont}" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Ảnh mẫu" FontSize="12" TextAlignment="Center"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Choice}" Width="92" Height="100" Tag="p5" GroupName="Photos" Click="OnChoice" IsChecked="{Binding SelectedPhoto, Converter={StaticResource Equal}, ConverterParameter=5, Mode=OneWay}" Padding="6">
                      <StackPanel>
                        <TextBlock Text="5" FontFamily="{StaticResource HeadingFont}" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Ảnh mẫu" FontSize="12" TextAlignment="Center"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Choice}" Width="92" Height="100" Tag="p6" GroupName="Photos" Click="OnChoice" IsChecked="{Binding SelectedPhoto, Converter={StaticResource Equal}, ConverterParameter=6, Mode=OneWay}" Padding="6">
                      <StackPanel>
                        <TextBlock Text="6" FontFamily="{StaticResource HeadingFont}" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Ảnh mẫu" FontSize="12" TextAlignment="Center"/>
                      </StackPanel>
                    </RadioButton>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{Binding SelectionHint}" Style="{StaticResource Body}" FontSize="15" Margin="0,24,0,0"/>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" Content="{Binding RetakeLabel}" Style="{StaticResource Back}" Click="OnRetake" IsEnabled="{Binding CanRetake}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="IN ẢNH" Style="{StaticResource Action}" Click="OnNext" IsEnabled="{Binding CanPrint}"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Printing">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text=""/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="▣" Style="{StaticResource Heading}" FontSize="64"/>
              <TextBlock Text="Đang in ảnh của bạn" Style="{StaticResource Heading}" Margin="0,24,0,0"/>
              <TextBlock Text="PRINTING YOUR PHOTOS · GIỮ VỮNG VUI CHỜ NHÉ" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}" Margin="0,22,0,0"/>
              <ProgressBar Value="{Binding PrintProgress}" Maximum="100" Height="10" Width="360" Foreground="{StaticResource Rose}" Background="{StaticResource Line}" BorderThickness="0" Margin="0,28,0,0" AutomationProperties.Name="Tiến trình in mô phỏng"/>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="HOÀN TẤT" Style="{StaticResource Action}" Click="OnNext" IsEnabled="{Binding CanFinishPrint}"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Delivery">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Quét mã QR để tải file"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="SCAN FOR YOUR DIGITAL FILE"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0">
              <Border Style="{StaticResource Panel}" Width="205" Height="240" Margin="12" BorderBrush="{StaticResource Rose}">
                <TextBlock Text="PHOTO FILE" Style="{StaticResource Body}" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center" Margin="12">
                <Border Width="205" Height="205" CornerRadius="16" BorderBrush="{StaticResource Rose}" BorderThickness="2" Background="{StaticResource Card}" HorizontalAlignment="Center">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="[MÃ QR]" Foreground="{StaticResource ActionRose}" FontSize="20" TextAlignment="Center"/>
                    <TextBlock Text="Bản xem trước" Style="{StaticResource Body}" FontSize="14" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="SCAN QR CODE" Style="{StaticResource Subtitle}"/>
              </StackPanel>
              <Border Style="{StaticResource Panel}" Width="205" Height="240" Margin="12" BorderBrush="{StaticResource Rose}">
                <TextBlock Text="VIDEO FILE" Style="{StaticResource Body}" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" Content="CHỤP PHIÊN MỚI" Click="OnRestart" Style="{StaticResource Action}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>
    <Viewbox Stretch="Uniform">
      <Grid x:Name="Canvas" Width="1280" Height="720" Background="{StaticResource Cream}">
        <Grid.RowDefinitions>
          <RowDefinition Height="76"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Brand" Foreground="{StaticResource Ink}" FontFamily="{StaticResource HeadingFont}" FontSize="27" Margin="64,24,0,0" VerticalAlignment="Top">
          <Run Text="Foto " FontStyle="Italic"/>
          <Run Text="Hunter" FontWeight="Bold"/>
        </TextBlock>
        <StackPanel x:Name="ProgressMarks" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,64,0"/>
        <ContentControl x:Name="ScreenContent" Grid.Row="1" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
    </Viewbox>
    <Border Grid.Row="1" Background="{StaticResource Ink}">
      <TextBlock x:Name="PreviewNotice" Text="BẢN XEM TRƯỚC UI · Ảnh, thanh toán, in và QR đều mô phỏng · F11: toàn màn hình · Esc: thu nhỏ" Foreground="{StaticResource Cream}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    </Border>
  </Grid>
</Window>
