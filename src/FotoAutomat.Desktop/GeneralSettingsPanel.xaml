<UserControl x:Class="FotoAutomat.Desktop.GeneralSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FotoAutomat.Desktop"
             Background="{DynamicResource PageBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnPanelLoaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="2026-10-20-AdminDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Bốn trang dùng chung một panel và một thanh lưu: "Cài đặt chung", "Màn hình & thương hiệu", "Quyền quản trị", "Chế độ cho khách". -->
            <Style x:Key="GeneralPageOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:GeneralSettingsPanel}}}" Value="Chế độ cho khách">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:GeneralSettingsPanel}}}" Value="Màn hình &amp; thương hiệu">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:GeneralSettingsPanel}}}" Value="Quyền quản trị">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BrandPageOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:GeneralSettingsPanel}}}" Value="Màn hình &amp; thương hiệu">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ModesPageOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:GeneralSettingsPanel}}}" Value="Chế độ cho khách">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SecurityPageOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:GeneralSettingsPanel}}}" Value="Quyền quản trị">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- PIN có nút lưu riêng; trang Quyền quản trị không dùng thanh lưu chung. -->
            <Style x:Key="HiddenOnSecurityPage" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:GeneralSettingsPanel}}}" Value="Quyền quản trị">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Màu của header giao diện khách (CustomerTheme.xaml: Cream, Ink, HeadingFont). -->
            <!-- Ô màu mẫu: vòng ngoài (BorderBrush) báo màu đang chọn. -->
            <Style x:Key="SwatchButton" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>
                                <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="1"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <SolidColorBrush x:Key="CustomerCream" Color="#FAF3E9"/>
            <SolidColorBrush x:Key="CustomerInk" Color="#3F2D22"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề trang -->
        <TextBlock Grid.Row="0" Text="{Binding Section, FallbackValue=Cài đặt chung}" Style="{StaticResource TextTitle}" Margin="24,24,24,16"/>

        <!-- Nội dung -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,0,24,8" MaxWidth="1120" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái -->
                <StackPanel Grid.Column="0">
                    <!-- Quyền quản trị -->
                    <StackPanel Style="{StaticResource SecurityPageOnly}">
                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Bảo mật" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="PinStatus" Style="{StaticResource TextCaption}" Margin="0,0,0,16"/>

                                <StackPanel x:Name="CurrentPinPanel">
                                    <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="PIN hiện tại" Margin="0,0,0,16">
                                        <PasswordBox x:Name="CurrentPin" MaxLength="12"/>
                                    </HeaderedContentControl>
                                </StackPanel>
                                <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="PIN mới (6–12 chữ số)" Margin="0,0,0,16">
                                    <PasswordBox x:Name="NewPin" MaxLength="12"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Nhập lại PIN" Margin="0,0,0,16">
                                    <PasswordBox x:Name="ConfirmPin" MaxLength="12"/>
                                </HeaderedContentControl>
                                <Button Content="Lưu PIN" Click="OnSavePin" HorizontalAlignment="Left" MinWidth="96"/>
                                <TextBlock x:Name="PinFeedback" Style="{StaticResource TextCaption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Màn hình & thương hiệu -->
                    <StackPanel Style="{StaticResource BrandPageOnly}">
                        <Border x:Name="BrandCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Thương hiệu" Style="{StaticResource TextCardTitle}" Margin="0,0,0,16"/>
                                <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Tên thương hiệu" Margin="0,0,0,16">
                                    <TextBox x:Name="BrandName" MaxLength="80"/>
                                </HeaderedContentControl>
                                <TextBlock Text="Logo" Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Height="120" Padding="12">
                                    <Grid>
                                        <Image x:Name="LogoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="LogoEmpty" Text="Chưa có logo" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Chọn logo…" Click="OnPickLogo" MinWidth="112" Margin="0,0,8,0"/>
                                    <Button x:Name="RemoveLogoButton" Content="Xóa logo" Click="OnRemoveLogo" MinWidth="96"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ThemeCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Giao diện khách" Style="{StaticResource TextCardTitle}" Margin="0,0,0,16"/>
                                <TextBlock Text="Màu nhấn" Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,16">
                                    <TextBox x:Name="AccentHex" DockPanel.Dock="Right" Width="104" MaxLength="7" TextChanged="OnThemeTextChanged" AutomationProperties.Name="Mã màu nhấn"/>
                                    <WrapPanel x:Name="AccentSwatches" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Màu nền" Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,16">
                                    <TextBox x:Name="BackgroundHex" DockPanel.Dock="Right" Width="104" MaxLength="7" TextChanged="OnThemeTextChanged" AutomationProperties.Name="Mã màu nền"/>
                                    <WrapPanel x:Name="BackgroundSwatches" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Ảnh nền" Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Height="96" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="BackgroundImage" Stretch="UniformToFill"/>
                                        <TextBlock x:Name="BackgroundEmpty" Text="Chưa có ảnh nền" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Chọn ảnh nền…" Click="OnPickBackground" MinWidth="112" Margin="0,0,8,0"/>
                                    <Button x:Name="RemoveBackgroundButton" Content="Xóa ảnh nền" Click="OnRemoveBackground" MinWidth="96"/>
                                </StackPanel>
                                <TextBlock Text="Ảnh màn chờ" Style="{StaticResource TextCaption}" Margin="0,20,0,8"/>
                                <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Height="120" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="LoadingImage" Stretch="UniformToFill"/>
                                        <TextBlock x:Name="LoadingEmpty" Text="Dùng ảnh của chế độ khách chọn" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Chọn ảnh màn chờ…" Click="OnPickLoading" MinWidth="112" Margin="0,0,8,0"/>
                                    <Button x:Name="RemoveLoadingButton" Content="Xóa ảnh" Click="OnRemoveLoading" MinWidth="96"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- Cài đặt chung -->
                    <StackPanel Style="{StaticResource GeneralPageOnly}">
                        <Border x:Name="DisplayCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Hiển thị" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="FullScreen" Style="{StaticResource SwitchStyle}" Content="Mở giao diện khách toàn màn hình"/>
                                <Border Style="{StaticResource DividerStyle}"/>
                                <CheckBox x:Name="Acceleration" Style="{StaticResource SwitchStyle}" Content="Tăng tốc đồ họa"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConnectionCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Kết nối" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                                <DockPanel MinHeight="44">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeStyle}" Tag="Neutral" VerticalAlignment="Center">
                                        <TextBlock Text="Chưa kết nối" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="API điều khiển booth" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Cột phải -->
                <StackPanel Grid.Column="2">
                    <!-- Màn hình & thương hiệu -->
                    <StackPanel Style="{StaticResource BrandPageOnly}">
                        <Border x:Name="PreviewCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Xem trước" Style="{StaticResource TextCardTitle}" Margin="0,0,0,16"/>
                                <Border x:Name="PreviewSurface" Background="{StaticResource CustomerCream}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                    <Grid Height="240">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Ảnh nền và lớp phủ màu nền, như giao diện khách. -->
                                        <Image x:Name="PreviewBackdrop" Grid.RowSpan="2" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        <Rectangle x:Name="PreviewOverlay" Grid.RowSpan="2" Opacity="0.55" Visibility="Collapsed"/>
                                        <Ellipse x:Name="PreviewGlow" Grid.RowSpan="2" Width="260" Height="200" Opacity="0.7"/>
                                        <!-- Header góc trái (các màn sau màn chào) và tiến trình, theo tỉ lệ giao diện khách 1280 × 720. -->
                                        <Image x:Name="PreviewHeaderLogo" Height="22" Margin="20,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="PreviewHeaderName" Text="{Binding Text, ElementName=BrandName}" Foreground="{StaticResource CustomerInk}" FontFamily="Georgia" FontSize="14" Margin="20,14,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" MaxWidth="180" HorizontalAlignment="Left"/>
                                        <StackPanel x:Name="PreviewProgress" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="16,0,16,16">
                                            <Image x:Name="PreviewTitleLogo" MaxHeight="80" MaxWidth="320" HorizontalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="PreviewTitleName" Text="{Binding Text, ElementName=BrandName}" Foreground="{StaticResource CustomerInk}" FontFamily="Georgia" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border x:Name="PreviewStart" BorderThickness="1.5" CornerRadius="14" Padding="18,6" Margin="0,14,0,0" HorizontalAlignment="Center">
                                                <TextBlock x:Name="PreviewStartText" Text="CHẠM ĐỂ BẮT ĐẦU" FontFamily="Georgia" FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <Border x:Name="PreviewAction" Grid.Row="1" CornerRadius="12" Padding="14,5" Margin="0,0,16,12" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="THANH TOÁN" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ActivationCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <DockPanel MinHeight="44">
                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeStyle}" Tag="Neutral" VerticalAlignment="Center">
                                    <TextBlock Text="Chưa kết nối" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="Kích hoạt thương hiệu" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Border>


                    </StackPanel>

                    <!-- Cài đặt chung -->
                    <StackPanel Style="{StaticResource GeneralPageOnly}">
                        <Border x:Name="FolderCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Thư mục" Style="{StaticResource TextCardTitle}" Margin="0,0,0,16"/>

                                <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Dữ liệu booth" Margin="0,0,0,16">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Chọn…" Tag="data" Click="OnBrowse" Margin="8,0,0,0" MinWidth="80"/>
                                        <TextBox x:Name="DataFolder"/>
                                    </DockPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Thư mục xuất ảnh" Margin="0,0,0,16">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Chọn…" Tag="export" Click="OnBrowse" Margin="8,0,0,0" MinWidth="80"/>
                                        <TextBox x:Name="ExportFolder"/>
                                    </DockPanel>
                                </HeaderedContentControl>

                                <TextBlock Text="Loại tệp xuất" Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="Originals" Content="Ảnh gốc"/>
                                    <CheckBox x:Name="Prints" Content="Ảnh in"/>
                                    <CheckBox x:Name="Gif" Content="GIF"/>
                                    <CheckBox x:Name="Timelapse" Content="Timelapse"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Chế độ cho khách: mỗi bộ lọc đã phát hành một hàng (ảnh, chữ trên thẻ, tính năng). -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource ModesPageOnly}">
                    <Border x:Name="ModeCardsCard" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="ModeCardsEmpty" Text="Chưa có bộ lọc đã phát hành" Style="{StaticResource TextCaption}" Visibility="Collapsed"/>
                            <StackPanel x:Name="ModeCardRows"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Thanh lưu -->
        <Grid Grid.Row="2" Style="{StaticResource HiddenOnSecurityPage}">
            <Border Style="{StaticResource SaveBarStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RevertButton" Content="Hoàn tác" Click="OnRevert" Margin="0,0,8,0" MinWidth="96"/>
                        <Button x:Name="SaveButton" Content="Lưu cài đặt" Click="OnSave" Style="{StaticResource PrimaryButton}" MinHeight="40" MinWidth="128"/>
                    </StackPanel>
                    <TextBlock x:Name="DirtyText" DockPanel.Dock="Left" Style="{StaticResource TextSaveState}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="Feedback" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
