<Window x:Class="FotoAutomat.Desktop.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FotoAutomat | Simulator" Width="1000" Height="720"
        MinWidth="800" MinHeight="600" Background="#F5F3EF">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36">
      <TextBlock Text="FOTOAUTOMAT" FontSize="15" FontWeight="Bold" Foreground="#5C635B" />
      <TextBlock Text="Booth simulator" FontSize="36" FontWeight="SemiBold" Margin="0,8,0,16" />
      <Border Background="#FFF0C2" Padding="16" Margin="0,0,0,24">
        <TextBlock Text="SIMULATION ONLY. No money is accepted. No camera or printer is connected."
                   TextWrapping="Wrap" FontSize="16" />
      </Border>
      <TextBlock x:Name="SessionLabel" FontSize="14" TextWrapping="Wrap" />
      <TextBlock x:Name="StageLabel" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,8"
                 AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20"
                 AutomationProperties.LiveSetting="Polite" />
      <WrapPanel>
        <Button x:Name="StartButton" Content="New demo session" Click="OnStart" />
        <Button x:Name="PayButton" Content="Simulate payment" Click="OnPayment" />
        <Button x:Name="CaptureButton" Content="Capture test image" Click="OnCapture" />
        <Button x:Name="PrintButton" Content="Simulate print" Click="OnPrint" />
      </WrapPanel>
      <Border Background="#E3E5DF" Height="180" Margin="0,8,0,16">
        <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="Synthetic camera image" />
      </Border>
      <TextBlock Text="Color recipes, beauty processing, frames, QR delivery and fleet updates are planned."
                 TextWrapping="Wrap" FontSize="14" Foreground="#555555" />
      <TextBlock x:Name="DataLabel" TextWrapping="Wrap" FontSize="12" Foreground="#555555" Margin="0,12,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
