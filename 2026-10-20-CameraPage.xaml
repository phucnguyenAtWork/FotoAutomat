<UserControl x:Class="FotoAutomat.Admin.Camera.CameraPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FotoAutomat.Admin.Camera"
             Background="{DynamicResource PageBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             Foreground="{DynamicResource TextBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Khi dùng cho nhiều trang, chuyển dòng này sang App.xaml. -->
                <ResourceDictionary Source="2026-10-20-ThemeExtras.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Một thông số máy ảnh: nhãn + chấm "chưa áp lên máy" + ComboBox -->
            <DataTemplate DataType="{x:Type vm:CameraParameter}">
                <HeaderedContentControl Style="{StaticResource FieldStyle}" Margin="6,0,6,16">
                    <HeaderedContentControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}"/>
                            <Ellipse Width="6" Height="6" Margin="6,0,0,0"
                                     Fill="{StaticResource AccentBrush}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPendingApply}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>
                    </HeaderedContentControl.Header>
                    <ComboBox Style="{StaticResource ComboBoxStyle}"
                              Tag="Chưa đọc"
                              ItemsSource="{Binding Options}"
                              SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                              IsEnabled="{Binding IsAvailable}"
                              AutomationProperties.Name="{Binding Label}"/>
                </HeaderedContentControl>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Tiêu đề trang ===== -->
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Máy ảnh" Style="{StaticResource TextTitle}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource StatusBadgeStyle}" Tag="{Binding StatusKind}"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ShowGuideCommand}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextIcon}" Text="&#xE897;"/>
                    <TextBlock Text="Hướng dẫn" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Lỗi toàn trang ===== -->
        <Border Grid.Row="1" Style="{StaticResource BannerStyle}" Tag="Error" Margin="24,0,24,16"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource TextBody}" Text="{Binding ErrorMessage}"/>
        </Border>

        <!-- ===== Nội dung: live view bên trái, điều khiển bên phải ===== -->
        <Grid Grid.Row="2" Margin="24,0,24,24" KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="376"/>
            </Grid.ColumnDefinitions>

            <!-- Live view -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" KeyboardNavigation.TabIndex="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kiểm tra khung hình" Style="{StaticResource TextCardTitle}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource TextCaption}"
                                   Text="{Binding LiveViewCaption}"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,12" MinHeight="240" CornerRadius="6"
                            Background="{StaticResource LiveViewBrush}" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding LiveViewImage}" Stretch="Uniform"
                                   AutomationProperties.Name="Khung xem trực tiếp từ máy ảnh"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource TextIcon}" Text="&#xE722;" FontSize="32"
                                           Foreground="{StaticResource TextDisabledBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Chưa có live view" FontSize="16" Margin="0,12,0,4"
                                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CaptureTestCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TextIcon}" Text="&#xE722;"/>
                                <TextBlock Text="Chụp thử" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}"
                                Content="Trở lại live view" Command="{Binding ReturnToLiveViewCommand}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                Content="Mở ảnh…" Click="OpenImage_Click"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Cột điều khiển -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" KeyboardNavigation.TabIndex="0" IsTabStop="False">
                <StackPanel>

                    <!-- Kết nối thiết bị -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Kết nối thiết bị" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12"/>

                            <!-- Chưa kết nối: chọn máy -->
                            <StackPanel IsEnabled="{Binding CanEditConnection}"
                                        Visibility="{Binding ShowPicker, Converter={StaticResource BoolToVis}}">
                                <HeaderedContentControl Header="Hãng máy" Style="{StaticResource FieldStyle}" Margin="0,0,0,16">
                                    <ComboBox Style="{StaticResource ComboBoxStyle}"
                                              ItemsSource="{Binding Brands}"
                                              SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"/>
                                </HeaderedContentControl>

                                <HeaderedContentControl Header="Model" Style="{StaticResource FieldStyle}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Style="{StaticResource ComboBoxStyle}" Tag="Chưa chọn máy"
                                                  ItemsSource="{Binding Cameras}"
                                                  SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"/>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DetectCommand}"
                                                Padding="12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource TextIcon}" Text="&#xE72C;"/>
                                                <TextBlock Text="Dò lại" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </HeaderedContentControl>

                                <Border Style="{StaticResource BannerStyle}" Tag="Warning" Margin="0,0,0,16"
                                        Visibility="{Binding NoCameraFound, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource TextBody}"
                                               Text="Không thấy máy ảnh nào. Cắm cáp USB, bật máy rồi bấm Dò lại."/>
                                </Border>

                                <Button Style="{StaticResource PrimaryButton}" Content="Kết nối USB"
                                        Command="{Binding ConnectCommand}"/>
                            </StackPanel>

                            <!-- Đã kết nối: tóm tắt + ngắt -->
                            <Grid Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectedName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource TextCaption}" Text="Kết nối qua USB" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Content="Ngắt kết nối" Margin="12,0,0,0"
                                        Command="{Binding DisconnectCommand}"/>
                            </Grid>

                            <!-- Nâng cao -->
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                                    Margin="0,16,0,0" Padding="0,12,0,0">
                                <Expander Header="Đường dẫn SDK" Style="{StaticResource DisclosureExpanderStyle}"
                                          IsEnabled="{Binding CanEditConnection}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource TextBoxStyle}"
                                                 Text="{Binding SdkPath, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Đường dẫn SDK"/>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                Content="Chọn…" Click="BrowseSdk_Click"/>
                                    </Grid>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Thông số chụp -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Thông số chụp" Style="{StaticResource TextCardTitle}"/>
                            <ProgressBar Style="{StaticResource ThinProgressBarStyle}" Margin="0,10,0,10"
                                         IsIndeterminate="{Binding IsBusy}"/>

                            

                            <!-- Lưới 2 cột; lề âm bù cho lề của từng ô để mép trái/phải thẳng với tiêu đề card. -->
                            <ItemsControl ItemsSource="{Binding Parameters}" IsEnabled="{Binding IsConnected}"
                                          IsTabStop="False" Margin="-6,0,-6,-16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ReadCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TextIcon}" Text="&#xE896;"/>
                                        <TextBlock Text="Đọc từ máy" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TextIcon}" Text="&#xE898;"/>
                                        <TextBlock Text="Áp lên máy" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Style="{StaticResource TextNote}" Margin="0,12,0,0"
                                       Text="{Binding ActionMessage}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Thanh lưu cấu hình ===== -->
        <Border Grid.Row="3" Style="{StaticResource SaveBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedConfig}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding SaveStatusText}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Hoàn tác"
                            Command="{Binding UndoCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Lưu cấu hình PC"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>


