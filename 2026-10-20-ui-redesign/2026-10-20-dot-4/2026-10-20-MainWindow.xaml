<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FotoAutomat.Desktop" x:Class="FotoAutomat.Desktop.MainWindow" Title="FotoAutomat | Customer UI preview" Width="1360" Height="850" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#FAF3E9" FontFamily="Segoe UI" UseLayoutRounding="True" PreviewKeyDown="OnWindowKey">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CustomerTheme.xaml"/>
        <ResourceDictionary Source="TouchControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <local:CustomerPhotoConverter x:Key="CustomerPhoto"/><local:LayoutEffectConverter x:Key="LayoutEffect"/><local:IndexEqualsConverter x:Key="Equal"/><BooleanToVisibilityConverter x:Key="Visible"/>
      <DataTemplate x:Key="Welcome">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text=""/>
            </StackPanel>
            <Grid>
              <Ellipse Width="570" Height="480" Opacity="0.7">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#F3D2DF"/>
                    <GradientStop Color="#00FAF3E9" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <StackPanel VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" Foreground="{StaticResource Ink}" FontSize="78" FontWeight="Bold" FontFamily="{StaticResource HeadingFont}" MaxWidth="900" TextTrimming="CharacterEllipsis" Text="{Binding BrandTitle, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding HasNoBrandLogo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                <Image MaxWidth="520" MaxHeight="200" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding BrandLogo, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding HasBrandLogo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
                <Button Content="CHẠM ĐỂ BẮT ĐẦU" Click="OnNext" Style="{StaticResource Back}" BorderBrush="{StaticResource Rose}" Foreground="{StaticResource ActionRose}" FontFamily="{StaticResource HeadingFont}" FontSize="28" Margin="0,46,0,10" HorizontalAlignment="Center" Padding="52,20"/>
                <TextBlock Text="TOUCH TO START" Style="{StaticResource Body}"/>
              </StackPanel>
            </Grid>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding BrandFooter, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Bottom" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Filter">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Chọn bộ lọc màu ảnh"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="SELECT COLOR FILTER"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilterChoices, RelativeSource={RelativeSource AncestorType=Window}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <RadioButton Style="{StaticResource Choice}" Width="270" Height="220" Tag="{Binding Index}" GroupName="FilterIndex" Click="OnPresetChoice" IsChecked="{Binding Selected, Mode=OneWay}">
                      <StackPanel><Image Width="230" Height="145" Stretch="Uniform" Source="{Binding Image}"/><TextBlock Text="{Binding Name}" FontSize="22" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/></StackPanel>
                    </RadioButton>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="Bộ lọc do quản trị viên cửa hàng thiết lập" Style="{StaticResource Body}" FontSize="15" Margin="0,30,0,0"/>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="TIẾP TỤC" Style="{StaticResource Action}" Click="OnNext"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Layout">
<Grid Margin="64,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="80"/></Grid.RowDefinitions>
<TextBlock Text="{Binding PackageHeading}" Style="{StaticResource Heading}"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
<RadioButton Content="{Binding PackageOptions[0].Label}" Tag="q0" Click="OnChoice" GroupName="Package" Style="{StaticResource Choice}" IsChecked="{Binding PackageIndex, Converter={StaticResource Equal}, ConverterParameter=0, Mode=OneWay}" Padding="22"/>
<RadioButton Content="{Binding PackageOptions[1].Label}" Tag="q1" Click="OnChoice" GroupName="Package" Style="{StaticResource Choice}" IsChecked="{Binding PackageIndex, Converter={StaticResource Equal}, ConverterParameter=1, Mode=OneWay}" Padding="22"/>
</StackPanel>
<Button Grid.Row="2" Content="QUAY LẠI" Click="OnBack" Style="{StaticResource Back}" HorizontalAlignment="Left"/>
<Button Grid.Row="2" Content="THANH TOÁN" Click="OnNext" Style="{StaticResource Action}" HorizontalAlignment="Right"/>
</Grid></DataTemplate>
      <DataTemplate x:Key="Payment">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Phương thức thanh toán"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="PAYMENT METHOD"/>
            </StackPanel>
            <Border Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0" Padding="20,12">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OrderSummary}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Amount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Wine}" Margin="24,0,0,0"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0">
              <Button Tag="cash" Click="OnPaymentChoice" Style="{StaticResource Back}" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" Width="275" Height="205" Margin="18">
                <StackPanel>
                  <TextBlock Text="▣" FontSize="44" Foreground="{StaticResource Wine}" TextAlignment="Center"/>
                  <TextBlock Text="Tiền mặt" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  <TextBlock Text="Cash" Style="{StaticResource Body}" FontSize="15" Margin="0,12,0,0"/>
                </StackPanel>
              </Button>
              <Button Tag="qr" Click="OnPaymentChoice" Style="{StaticResource Back}" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" Width="275" Height="205" Margin="18">
                <StackPanel>
                  <TextBlock Text="▦" FontSize="44" Foreground="{StaticResource Wine}" TextAlignment="Center"/>
                  <TextBlock Text="Chuyển khoản QR" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,16,0,0"/>
                  <TextBlock Text="Bank / e-wallet QR" Style="{StaticResource Body}" FontSize="15" Margin="0,12,0,0"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="QrPayment">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Quét mã để thanh toán"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="SCAN WITH YOUR BANKING OR E-WALLET APP"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,60,0,0">
              <Border Width="205" Height="205" CornerRadius="16" BorderBrush="{StaticResource Rose}" BorderThickness="2" Background="{StaticResource Card}" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="[MÃ QR]" Foreground="{StaticResource ActionRose}" FontSize="20" TextAlignment="Center"/>
                  <TextBlock Text="Bản xem trước" Style="{StaticResource Body}" FontSize="14" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding Amount}" Style="{StaticResource Heading}" FontSize="27" Margin="0,18,0,0"/>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="ĐÃ THANH TOÁN · MÔ PHỎNG" Style="{StaticResource Action}" Click="OnNext"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="CashPayment">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Thanh toán tiền mặt"/>
              <TextBlock Style="{StaticResource Subtitle}" Text="Hệ thống không trả lại tiền thừa · vui lòng cho đúng số tiền"/>
            </StackPanel>
            <UniformGrid Columns="3" VerticalAlignment="Center" Margin="100,40,100,0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SỐ TIỀN ĐÃ NHẬN" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="0đ" Style="{StaticResource Heading}" Margin="0,20,0,0"/>
              </StackPanel>
              <Border Style="{StaticResource Panel}" Width="94" Height="120" BorderBrush="{StaticResource Wine}">
                <TextBlock Text="↑" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CẦN THANH TOÁN" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Amount}" Style="{StaticResource Heading}" Foreground="{StaticResource Wine}" Margin="0,20,0,0"/>
              </StackPanel>
            </UniformGrid>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack"/>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="ĐÃ ĐỦ TIỀN · MÔ PHỎNG" Style="{StaticResource Action}" Click="OnNext"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Instructions">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text="Hướng dẫn chụp"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,40,0,0">
              <Border Width="172" Height="172" BorderBrush="{StaticResource Rose}" BorderThickness="2" CornerRadius="28" HorizontalAlignment="Center">
                <Grid>
                  <Ellipse Width="115" Height="115" Fill="{StaticResource Rose}" Stroke="{StaticResource Wine}" StrokeThickness="3"/>
                  <Ellipse Width="34" Height="34" Fill="{StaticResource Cream}" Stroke="{StaticResource Ink}" StrokeThickness="2"/>
                </Grid>
              </Border>
              <TextBlock Text="Nhìn thẳng ống kính, giữ dáng đến khi chụp xong." Style="{StaticResource Body}" Margin="0,28,0,0"/>
              <TextBlock Text="{Binding CaptureInstructions}" Style="{StaticResource Body}" Margin="0,10,0,0"/>
              <Button Content="SẴN SÀNG" Click="OnNext" Style="{StaticResource Action}" HorizontalAlignment="Center" Margin="0,30,0,0"/>
            </StackPanel>
          </Grid>
        <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Content="QUAY LẠI" Style="{StaticResource Back}" Click="OnBack" />
</Grid>
      </DataTemplate>
      <DataTemplate x:Key="Capture">
<Grid Margin="64,24"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition/><RowDefinition Height="80"/></Grid.RowDefinitions>
<TextBlock Text="{Binding SessionClock}" Foreground="{StaticResource Cream}" FontSize="25" HorizontalAlignment="Center" Visibility="{Binding ShowSessionClock, Converter={StaticResource Visible}}"/>
<Border Grid.Row="1" Width="680" Background="#403C39" CornerRadius="16" BorderBrush="{StaticResource Cream}" BorderThickness="1" Margin="0,14">
<Grid><Image Source="{Binding SelectedColorImage, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="Uniform"/><TextBlock Text="{Binding CaptureDisplay}" Background="#80000000" Padding="16,4" FontSize="64" Foreground="{StaticResource Cream}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
</Border>
<TextBlock Grid.Row="2" Text="{Binding CaptureLabel}" Style="{StaticResource Body}" Foreground="{StaticResource Cream}" VerticalAlignment="Center"/>
</Grid></DataTemplate>
<DataTemplate x:Key="Selection">
<Grid Margin="64,24"><Grid.RowDefinitions><RowDefinition Height="85"/><RowDefinition/><RowDefinition Height="80"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Chọn những ảnh bạn thích" Style="{StaticResource Heading}"/><TextBlock Text="{Binding SelectionHint}" Style="{StaticResource Body}" Margin="0,12"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Photos}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
<Button Tag="{Binding Number}" Click="OnPhoto" Width="205" Height="165" Margin="10" Style="{StaticResource Back}"><StackPanel><Image Height="100" Stretch="Uniform"><Image.Source><MultiBinding Converter="{StaticResource CustomerPhoto}"><Binding Path="Number"/><Binding RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Image.Source></Image><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<Button Grid.Row="2" Content="TIẾP TỤC" Click="OnNext" IsEnabled="{Binding CanChooseFrame}" Style="{StaticResource Action}" HorizontalAlignment="Right"/>
</Grid></DataTemplate>
<DataTemplate x:Key="Beauty">
<Grid Margin="64,24"><Grid.RowDefinitions><RowDefinition Height="85"/><RowDefinition/><RowDefinition Height="80"/></Grid.RowDefinitions>
<TextBlock Text="Làm đẹp" Style="{StaticResource Heading}"/>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Panel}" Margin="0,0,32,0"><Grid><Image Source="{Binding SelectedColorImage, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="Uniform"/><TextBlock Text="{Binding BeautyPhotoLabel}" Style="{StaticResource Body}" VerticalAlignment="Bottom"/></Grid></Border>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Mức làm đẹp" Style="{StaticResource Body}"/><TextBlock Text="{Binding BeautyLevel, StringFormat='{}{0}%'}" Style="{StaticResource Heading}" Margin="0,12"/>
<Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BeautyLevel, Mode=TwoWay}" Height="52" AutomationProperties.Name="Mức làm đẹp"/>
<Button Content="ĐẶT LẠI" Click="OnResetBeauty" Style="{StaticResource Back}" Margin="0,16"/>
<ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding FavoritePhotos}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Number}" Click="OnPhoto" Width="150" Height="64" Margin="4" Style="{StaticResource Back}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</StackPanel></Grid>
<Button Grid.Row="2" Content="QUAY LẠI" Click="OnBack" Style="{StaticResource Back}" HorizontalAlignment="Left"/>
<Button Grid.Row="2" Content="CHỌN KHUNG" Click="OnNext" Style="{StaticResource Action}" HorizontalAlignment="Right"/>
</Grid></DataTemplate>
<DataTemplate x:Key="Frame">
<Grid Margin="64,24"><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="75"/><RowDefinition/><RowDefinition Height="80"/></Grid.RowDefinitions>
<TextBlock Text="{Binding FrameTitle}" Style="{StaticResource Heading}"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding UsesSampleFrames, Converter={StaticResource Visible}}"><RadioButton Content="Khung 3 ảnh" Tag="l0" Click="OnChoice" GroupName="FrameChoice" Padding="18,8" FontSize="18" Style="{StaticResource Choice}" IsChecked="{Binding LayoutIndex, Converter={StaticResource Equal}, ConverterParameter=0, Mode=OneWay}"/>
<RadioButton Content="Khung 4 ảnh" Tag="l1" Click="OnChoice" GroupName="FrameChoice" Padding="18,8" FontSize="18" Style="{StaticResource Choice}" IsChecked="{Binding LayoutIndex, Converter={StaticResource Equal}, ConverterParameter=1, Mode=OneWay}"/>
</StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="45"/></Grid.RowDefinitions>
<Viewbox Stretch="Uniform" Margin="12"><Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}" Background="{Binding FrameBackground}">
<ItemsControl ItemsSource="{Binding Slots}">
<ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="{Binding FrameWidth}" Height="{Binding FrameHeight}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
<ItemsControl.ItemTemplate><DataTemplate>
<Border Width="{Binding Width}" Height="{Binding Height}" BorderBrush="{Binding Appearance.StrokeColor, FallbackValue=#222222}" BorderThickness="{Binding Appearance.StrokeWidth, FallbackValue=0}" RenderTransformOrigin="0.5,0.5" Effect="{Binding Appearance, Converter={StaticResource LayoutEffect}}">
<Border.RenderTransform><RotateTransform Angle="{Binding Appearance.Rotation, FallbackValue=0}"/></Border.RenderTransform>
<Button IsHitTestVisible="{Binding IsPhoto}" Tag="{Binding Index}" Click="OnSlot" Padding="0" Margin="0" MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0"><Grid ClipToBounds="True"><local:LayoutElementVisual Element="{Binding Appearance}" Preview="True"/><Image Stretch="UniformToFill"><Image.Source><MultiBinding Converter="{StaticResource CustomerPhoto}"><Binding Path="Photo"/><Binding RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Image.Source><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPhoto}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Photo}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding Label}" FontSize="20" TextWrapping="Wrap" Visibility="{Binding IsPhoto, Converter={StaticResource Visible}}"/></Grid></Button>
</Border></DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>
<Image Panel.ZIndex="{Binding FrameArtworkZIndex, RelativeSource={RelativeSource AncestorType=Window}}" Source="{Binding FrameArtwork, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="Fill" IsHitTestVisible="False"/>
</Grid></Viewbox>
<TextBlock Grid.Row="1" Text="{Binding SelectionHint}" Style="{StaticResource Body}" FontSize="14" VerticalAlignment="Center"/>
</Grid><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding FavoritePhotos}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Number}" Click="OnPhoto" Width="165" Height="90" Margin="8" Style="{StaticResource Back}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</Grid>
<Button Grid.Row="3" Content="QUAY LẠI" Click="OnBack" Style="{StaticResource Back}" HorizontalAlignment="Left"/>
<Button Grid.Row="3" Content="IN ẢNH" Click="OnNext" IsEnabled="{Binding CanPrint}" Style="{StaticResource Action}" HorizontalAlignment="Right"/>
</Grid></DataTemplate>
      <DataTemplate x:Key="Printing">
        <Grid Margin="64,24,64,24">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel VerticalAlignment="Top">
              <TextBlock Style="{StaticResource Heading}" Text=""/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="▣" Style="{StaticResource Heading}" FontSize="64"/>
              <TextBlock Text="Đang in ảnh của bạn" Style="{StaticResource Heading}" Margin="0,24,0,0"/>
              <TextBlock Text="PRINTING YOUR PHOTOS · GIỮ VỮNG VUI CHỜ NHÉ" Style="{StaticResource Subtitle}" Foreground="{StaticResource Muted}" Margin="0,22,0,0"/>
              <ProgressBar Value="{Binding PrintProgress}" Maximum="100" Height="10" Width="360" Foreground="{StaticResource Rose}" Background="{StaticResource Line}" BorderThickness="0" Margin="0,28,0,0" AutomationProperties.Name="Tiến trình in mô phỏng"/>
            </StackPanel>
          </Grid>
          <Button Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="HOÀN TẤT" Style="{StaticResource Action}" Click="OnNext" IsEnabled="{Binding CanFinishPrint}"/>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="Delivery">
<Grid Margin="64,24"><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition/><RowDefinition Height="80"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Ảnh của bạn" Style="{StaticResource Heading}"/><TextBlock Text="{Binding DeliverySummary}" Style="{StaticResource Body}" Margin="0,16"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Photos}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}" Width="185" Height="160" Margin="8"><StackPanel><Image Height="110" Stretch="Uniform"><Image.Source><MultiBinding Converter="{StaticResource CustomerPhoto}"><Binding Path="Number"/><Binding RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Image.Source></Image><TextBlock Text="{Binding Label}" Style="{StaticResource Body}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<Button Grid.Row="2" Content="CHỤP PHIÊN MỚI" Click="OnRestart" Style="{StaticResource Action}" HorizontalAlignment="Center"/>
</Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>
    <Viewbox Stretch="Uniform">
      <Grid x:Name="Canvas" Width="1280" Height="720" Background="{StaticResource Cream}">
        <Grid.RowDefinitions>
          <RowDefinition Height="76"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Brand" Foreground="{StaticResource Ink}" FontFamily="{StaticResource HeadingFont}" FontSize="27" Margin="64,24,0,0" VerticalAlignment="Top">
          <Run Text="Foto " FontStyle="Italic"/>
          <Run Text="Hunter" FontWeight="Bold"/>
        </TextBlock>
        <Image x:Name="BrandLogoImage" Height="40" Margin="64,18,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
        <StackPanel x:Name="ProgressMarks" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,64,0"/>
        <ContentControl x:Name="ScreenContent" Grid.Row="1" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
    </Viewbox>
    <Button Click="OnAdminUnlock" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" Width="38" Height="38" ToolTip="Mở khóa quản trị" AutomationProperties.Name="Mở khóa quản trị">
      <Button.Style><Style TargetType="Button"><Setter Property="Opacity" Value="0.3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent" Padding="8"><Path Data="M4 10 H20 V23 H4 Z M7 10 V6 A5 5 0 0 1 17 6 V10 M12 15 V18" Stroke="#888888" StrokeThickness="1.8" Stretch="Uniform"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger></Style.Triggers></Style></Button.Style>
    </Button>
    <Border Grid.Row="1" Background="{StaticResource Ink}">
      <TextBlock x:Name="PreviewNotice" Text="BẢN XEM TRƯỚC UI · Ảnh, làm đẹp, thanh toán và in đều mô phỏng · F11: toàn màn hình · Esc: mở khóa" Foreground="{StaticResource Cream}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    </Border>
  </Grid>
</Window>
