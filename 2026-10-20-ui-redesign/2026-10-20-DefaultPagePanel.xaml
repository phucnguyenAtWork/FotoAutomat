<UserControl x:Class="FotoAutomat.Desktop.DefaultPagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="2026-10-20-AdminDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Trang mặc định cho mục chưa có thiết lập riêng (Màn hình & thương hiệu, Quyền quản trị).
        Chỉ hiện tên mục và mô tả có sẵn của mục đó (Section, SectionDescription của LayoutEditorViewModel).
        Không có nút, ô nhập hay chữ mới.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Section}" Style="{StaticResource TextTitle}" Margin="24,24,24,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" Padding="24,20" Margin="24,0,24,24" MaxWidth="960" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SectionDescription}" Style="{StaticResource TextBody}" Foreground="{StaticResource TextMutedBrush}"/>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
