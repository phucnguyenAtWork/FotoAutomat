<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Bản dựng lại giao diện của CompactColorControls.xaml (cùng x:Key, cùng hành vi).
    Tự chứa màu (không phụ thuộc Theme) vì được nạp bằng pack URI từ ColorEditorPanel / RetouchEditorPanel / RefineEditorPanel.
    Màu: nhấn #0F766E, đường kẻ #E3E6EB, viền #C9CED6, chữ #111827 (cùng token với 2026-10-20-Theme.xaml).
  -->

  <!-- Ô số nhỏ cạnh slider. Style tường minh để không bị lề lớn của cửa sổ quản trị làm cắt chữ. -->
  <Style x:Key="CompactNumericInput" TargetType="TextBox">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#C9CED6"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="Foreground" Value="#111827"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#0F766E"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptureSliderTrack" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="30"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent" Margin="2,0">
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource CaptureSliderTrack}" Background="#0F766E" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="26" Height="30"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" Stroke="#0F766E" StrokeThickness="2"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#E6F4F2"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#E6F4F2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource CaptureSliderTrack}" Background="#E3E6EB" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Slider over a gradient track (Color Editor, Color Balance): transparent track, the gradient is drawn behind it. -->
  <Style x:Key="GradientSlider" TargetType="Slider">
   <Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent" Margin="2,0">
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource CaptureSliderTrack}" Background="Transparent" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="26" Height="36"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse Width="16" Height="16" Fill="White" Stroke="#111827" StrokeThickness="1.5"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource CaptureSliderTrack}" Background="Transparent" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
