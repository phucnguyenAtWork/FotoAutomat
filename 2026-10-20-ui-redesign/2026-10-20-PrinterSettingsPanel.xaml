<UserControl x:Class="FotoAutomat.Desktop.PrinterSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FotoAutomat.Desktop"
             Background="{StaticResource PageBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnPanelLoaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="2026-10-20-AdminDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Hai trang dùng chung một panel: "Máy in" và "Căn chỉnh bản in". Nếu không đọc được Section thì hiện tất cả như trước. -->
            <Style x:Key="PrinterPageOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:PrinterSettingsPanel}}}" Value="Căn chỉnh bản in">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AlignmentPageOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType={x:Type local:PrinterSettingsPanel}}}" Value="Máy in">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cài đặt in" Style="{StaticResource TextTitle}" Margin="24,24,24,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- SettingsContent giữ DataContext = cấu hình in (mã nguồn gán DataContext cho phần tử này) -->
            <Grid x:Name="SettingsContent" Margin="24,0,24,24" MaxWidth="1120" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: máy in, căn chỉnh -->
                <StackPanel Grid.Column="0">
                    <Grid Style="{StaticResource PrinterPageOnly}">
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Máy in" Style="{StaticResource TextCardTitle}" Margin="0,0,0,16"/>
                            <ComboBox x:Name="PrinterRole" SelectedIndex="0" SelectionChanged="OnRoleChanged" Margin="0,0,0,16">
                                <ComboBoxItem Content="Máy in chính"/>
                                <ComboBoxItem Content="Máy in phụ"/>
                            </ComboBox>
                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                <TextBlock x:Name="QueueLabel" Text="Chưa chọn máy in" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Cấu hình máy in…" Click="OnConfigure" Margin="0,0,8,0"/>
                                <Button Content="Thêm máy in trong Windows" Click="OnWindowsPrinters"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <Grid Style="{StaticResource AlignmentPageOnly}">
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Căn chỉnh bản in" Style="{StaticResource TextCardTitle}" Margin="0,0,0,16"/>
                            <StackPanel x:Name="Alignment">
                                <Grid MinHeight="44" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Tỉ lệ" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <local:NumericStepper Grid.Column="1" Minimum="50" Maximum="150" Step="0.5" Format="0.0" Unit="%"
                                                          Value="{Binding Scale, Mode=TwoWay}" ValueChanged="OnAlignmentChanged"
                                                          VerticalAlignment="Center" AutomationProperties.Name="Tỉ lệ"/>
                                </Grid>

                                <Grid MinHeight="44" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vị trí ngang" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <local:NumericStepper Grid.Column="1" Minimum="-20" Maximum="20" Step="0.1" Format="0.0" Unit="mm"
                                                          Value="{Binding OffsetX, Mode=TwoWay}" ValueChanged="OnAlignmentChanged"
                                                          VerticalAlignment="Center" AutomationProperties.Name="Vị trí ngang"/>
                                </Grid>

                                <Grid MinHeight="44" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vị trí dọc" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <local:NumericStepper Grid.Column="1" Minimum="-20" Maximum="20" Step="0.1" Format="0.0" Unit="mm"
                                                          Value="{Binding OffsetY, Mode=TwoWay}" ValueChanged="OnAlignmentChanged"
                                                          VerticalAlignment="Center" AutomationProperties.Name="Vị trí dọc"/>
                                </Grid>
                            </StackPanel>
                            <Button Content="Đặt lại căn chỉnh" Click="OnReset" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </StackPanel>

                <!-- Cột phải: tùy chọn in, giới hạn -->
                <StackPanel Grid.Column="2" Style="{StaticResource PrinterPageOnly}">
                    <Border Style="{StaticResource CardStyle}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Tùy chọn in" Style="{StaticResource TextCardTitle}" Margin="0,0,0,8"/>
                            <CheckBox Style="{StaticResource SwitchStyle}" Content="Tự động in sau phiên chụp" IsChecked="{Binding AutomaticPrint}"/>
                            <Border Style="{StaticResource DividerStyle}"/>
                            <CheckBox Style="{StaticResource SwitchStyle}" Content="Hiện nút in thêm" IsChecked="{Binding ShowPrintButton}"/>
                            <Border Style="{StaticResource DividerStyle}"/>
                            <CheckBox Style="{StaticResource SwitchStyle}" Content="In luân phiên hai máy" IsChecked="{Binding AlternatePrinters}"/>
                            <Border Style="{StaticResource DividerStyle}"/>
                            <CheckBox x:Name="Pair" Style="{StaticResource SwitchStyle}" Content="Ghép hai dải 2 × 6 trên tờ 4 × 6"/>
                            <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,16"/>

                            <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Số tờ mỗi lượt" Margin="0,0,0,16">
                                <TextBox x:Name="Copies"/>
                            </HeaderedContentControl>

                            <Expander Header="Nhãn trên màn hình khách">
                                <StackPanel>
                                    <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Nút in" Margin="0,0,0,12">
                                        <TextBox Text="{Binding PrintLabel}"/>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Trạng thái đang in" Margin="0,0,0,12">
                                        <TextBox Text="{Binding PrintingLabel}"/>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Số bản in">
                                        <TextBox Text="{Binding CopiesLabel}"/>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SwitchStyle}" Content="Giới hạn in" FontWeight="SemiBold" IsChecked="{Binding LimitsEnabled}"/>
                            <StackPanel IsEnabled="{Binding LimitsEnabled}" Margin="0,8,0,0">
                                <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Số tờ tối đa mỗi sự kiện" Margin="0,0,0,16">
                                    <TextBox Text="{Binding EventLimit, ValidatesOnExceptions=True}"/>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource FieldStyle}" Header="Số tờ tối đa mỗi phiên">
                                    <TextBox Text="{Binding SessionLimit, ValidatesOnExceptions=True}"/>
                                </HeaderedContentControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource SaveBarStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RevertButton" Content="Hoàn tác" Click="OnRevert" Margin="0,0,8,0" MinWidth="96"/>
                    <Button x:Name="SaveButton" Content="Lưu cài đặt in" Click="OnSave" Style="{StaticResource PrimaryButton}" MinHeight="40" MinWidth="128"/>
                </StackPanel>
                <TextBlock x:Name="DirtyText" DockPanel.Dock="Left" Style="{StaticResource TextSaveState}" Margin="0,0,16,0"/>
                <TextBlock x:Name="Feedback" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
